# Minimal config — copy to .env and adjust
WG_HOST=vpn.example.com
PORT=51821
WG_PORT=51820
LANG=en
WG_ALLOWED_IPS=0.0.0.0/0
WG_DEFAULT_DNS=77.88.8.8, 77.88.8.1
WG_MTU=1280
WG_PERSISTENT_KEEPALIVE=20-25
# Generate with: node src/setup-password.mjs
# PASSWORD_HASH=

# AWG 3.1 optional overrides (defaults are generated once and persisted)
# JC=4
# JMIN=64
# JMAX=512
# Keep S1-S4 equal when RANDOM_TRAILERS is enabled.
# S1=24
# S2=24
# S3=24
# S4=24
# H1=1
# H2=2
# H3=3
# H4=4
# HEADER_PROTECTION_KEY=  # nonzero 32-byte base64 key; generated when omitted
# CONTENT_PADDING_ADDITION=16-64
# REKEY_AFTER_TIME=100-140
# REKEY_TIMEOUT=4-6
# REJECT_AFTER_TIME=160-200
# KEEPALIVE_TIMEOUT=9-14
# MAX_HANDSHAKE_ATTEMPTS=18-24
# RANDOM_TRAILERS=true
# DISABLE_COOKIES=false
# I1=
# I2=
# I3=
# I4=
# I5=
